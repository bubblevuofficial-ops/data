Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.blogger.com/static/v1/v-css/3523451998-lightbox_bundle.css

@charset "utf-8";

.CSS_ROUNDED_BOX_CONT { text-align: center; }

.CSS_ROUNDED_BOX_CONTENT { border: 3px solid transparent; border-radius: 3px; }

.CSS_CLEAR_BOTH_NO_HEIGHT { height: 0px; overflow: hidden; clear: both; }

.CSS_NINEGRID_CORNER { overflow: hidden; height: 100%; }

.CSS_NINEGRID_BOTTOM_LEFT_CORNER, .CSS_NINEGRID_TOP_LEFT_CORNER { float: left; }

.CSS_NINEGRID_BOTTOM_RIGHT_CORNER, .CSS_NINEGRID_TOP_RIGHT_CORNER { float: right; }

.CSS_NINEGRID_BOTTOM_EDGE, .CSS_NINEGRID_TOP_EDGE { overflow: hidden; height: 100%; }

.CSS_NINEGRID_TOP_EDGE, .CSS_NINEGRID_TOP_LEFT_CORNER, .CSS_NINEGRID_TOP_RIGHT_CORNER { position: relative; }

.CSS_NINEGRID_LEFT_EDGE { float: left; width: 100%; }

.CSS_NINEGRID_CENTER { position: relative; }

.CSS_COMPONENT_TAB_PANE_BUTTON_SELECTED, .CSS_COMPONENT_TAB_PANE_BUTTON_UNSELECTED { font-weight: 700; }

.CSS_COMPONENT_TAB_PANE_BUTTON_UNSELECTED, .CSS_COMPONENT_TAB_PANE_BUTTON_UNSELECTED .CSS_COMPONENT_TAB_PANE_BUTTON_TITLE { color: rgb(0, 101, 204); cursor: pointer; text-decoration: underline; }

.CSS_COMPONENT_TAB_PANE_BUTTON_SELECTED .CSS_COMPONENT_TAB_PANE_BUTTON_TITLE { color: rgb(0, 0, 0); cursor: text; outline: none; text-decoration: none; }

.CSS_COMPONENT_TAB_PANE_HORIZONTAL .CSS_COMPONENT_TAB_PANE_BUTTON_SELECTED, .CSS_COMPONENT_TAB_PANE_HORIZONTAL .CSS_COMPONENT_TAB_PANE_BUTTON_UNSELECTED { float: left; padding: 3px 8px; }

.CSS_COMPONENT_TAB_PANE_VERTICAL .CSS_COMPONENT_TAB_PANE_BUTTON_SELECTED, .CSS_COMPONENT_TAB_PANE_VERTICAL .CSS_COMPONENT_TAB_PANE_BUTTON_UNSELECTED { float: right; padding: 3px; text-align: right; }

.CSS_VCONT_CHILDREN_HOLDER { width: 100%; bottom: 0px; }

.CSS_VCONT_PREVENT_MARGIN_COLLAPSE_DIV { font-size: 0px; height: 0px; line-height: 0; }

.CSS_HCONT_CHILDREN_HOLDER { float: left; }

.CSS_HCONT_CHILD { min-height: 1px; float: left; }

.CSS_COMPONENT_TABLE_HCONT_TABLE { position: relative; border-spacing: 0px; padding: 0px; border-collapse: collapse; }

.CSS_COMPONENT_TABLE_HCONT_WRAPPING_CELL { vertical-align: top; margin: 0px; padding: 0px; }

.CSS_COMPONENT_TABLE_HCONT_WIDTH_HOLDER { height: 0px; overflow: hidden; }

.CSS_LEFT_RIGHT_CONTAINER_LEFT_CHILD { float: left; }

.CSS_LEFT_RIGHT_CONTAINER_RIGHT_CHILD { float: right; }

.goog-inline-block { position: relative; display: inline-block; }

* html .goog-inline-block { display: inline; }

:first-child + html .goog-inline-block { display: inline; }

html.CSS_LIGHTBOX_FIXED_FRAME { margin: 0px; height: 100%; width: 100%; overflow: hidden !important; }

.CSS_LIGHTBOX { position: fixed; top: 0px; left: 0px; z-index: 10; }

.CSS_LIGHTBOX .goog-link, .CSS_LIGHTBOX .goog-link-disabled { outline: none; }

.CSS_LIGHTBOX_ADMIN_LINK { color: rgb(156, 16, 0); cursor: pointer; text-decoration: underline; }

.CSS_LIGHTBOX_BG_MASK { background-color: rgb(0, 0, 0); height: 100%; left: 0px; position: absolute; top: 0px; width: 100%; }

.CSS_LIGHTBOX_BG_MASK_TRANSPARENT { opacity: 0.9; }

.CSS_LIGHTBOX_BTN_CLOSE { cursor: pointer; background: url("/img/lightbox/lightbox_sprite.gif") no-repeat; width: 20px; height: 20px; top: 5px; position: absolute; z-index: 100; }

.CSS_LIGHTBOX_BTN_CLOSE_POS { right: 5px; }

.CSS_LIGHTBOX_BTN_ARROW { background-repeat: no-repeat; cursor: pointer; height: 93px; opacity: 0.17; padding: 50px 50px 50px 10px; position: absolute; width: 45px; z-index: 1; }

.CSS_LIGHTBOX_BTN_ARROW_LEFT { background-image: url("images/left-arrow.png"); background-position: 10px 50px; left: 0px; }

.CSS_LIGHTBOX_BTN_ARROW_RIGHT { background-image: url("images/right-arrow.png"); background-position: 50px 50px; right: 0px; }

.CSS_LIGHTBOX_BTN_ARROW_HOVER { opacity: 1; }

.CSS_LIGHTBOX_PHOTO_BROWSE_VIEW { font: 12px arial, sans-serif; }

.CSS_LIGHTBOX_PHOTO_BROWSE_CONTAINER { position: relative; }

.CSS_LIGHTBOX_SCALED_IMAGE { line-height: 0; width: 100%; height: 100%; overflow: hidden; text-align: center; }

.CSS_LIGHTBOX_SCALED_IMAGE_ERROR { outline: red solid 1px; }

.CSS_LIGHTBOX_SCALED_IMAGE_IMG { cursor: pointer; outline: rgb(0, 0, 0) solid 1px; position: relative; }

.CSS_LIGHTBOX_SCALED_IMAGE_CAPTION { top: 3px; left: 0px; line-height: normal; text-align: left; z-index: auto; }

.CSS_LIGHTBOX_SCALED_IMAGE_CAPTION_TEXT { color: rgb(204, 204, 204); font-size: 1em; padding: 2px 4px; overflow: hidden; }

.CSS_LIGHTBOX_SCALED_IMAGE_CAPTION_HINT_TEXT { color: rgb(119, 119, 119); font-size: 1em; padding: 2px 4px; }

.CSS_LIGHTBOX_SCALED_IMAGE_CAPTION_HOVER { border: 1px solid rgb(204, 204, 204); color: rgb(204, 204, 204); cursor: text; margin: -1px; }

.CSS_LIGHTBOX_SCALED_IMAGE_CAPTION_EDITOR { border: 1px solid rgb(204, 204, 204); background-color: rgb(102, 102, 102); color: rgb(204, 204, 204); font: 1em arial, sans-serif; margin: -1px; }

.CSS_LIGHTBOX_SCALED_IMAGE_FOOTER { position: relative; }

.CSS_LIGHTBOX_SCALED_IMAGE_PREVIOUS_IMAGE_CONTAINER { position: absolute; }

.CSS_LIGHTBOX_PLUS_ONE { padding-right: 8px; }

.ozLightboxPlusOne.ozPlusOneWidget { margin-top: 2px; }

.ozLightboxPlusOne.ozPlusOneButton { margin-right: 2px; margin-top: 1px; }

.CSS_LIGHTBOX_KENNEDY_SHARE_BUTTON.dark-button.jfk-button-default { background: rgb(35, 35, 35); box-shadow: rgba(101, 101, 101, 0.1) 0px 1px 0px inset; color: rgba(255, 255, 255, 0.8); }

.CSS_LIGHTBOX_SCALED_IMAGE .CSS_LIGHTBOX_TOOLBAR.CSS_LIGHTBOX_KENNEDY_BUTTON_TOOLBAR { padding-top: 10px !important; }

.CSS_LIGHTBOX_PLUS_ONE .ozStreamUpdatePlusoneCount { color: rgb(238, 238, 238); cursor: pointer; line-height: 1.1; text-align: left; vertical-align: top; }

.CSS_LIGHTBOX_INDEX_INFO { color: rgb(204, 204, 204); font-size: 0.84em; line-height: normal; min-height: 1em; position: relative; text-align: center; top: 2px; }

.CSS_LIGHTBOX_FILMSTRIP { background-color: rgb(0, 0, 0); line-height: 0; overflow: hidden; position: relative; width: 100%; height: 59px; }

.CSS_LIGHTBOX_FILMSTRIP_DISABLED { opacity: 0.5; }

.CSS_LIGHTBOX_FILMSTRIP_CONTROLS { width: 124px; top: 0px; position: absolute; }

.CSS_LIGHTBOX_FILMSTRIP_CONTROLS_FRAME { width: 52px; height: 52px; position: absolute; top: 0px; left: 35px; border: 1px solid rgb(255, 255, 255); margin-top: 3px; }

.CSS_LIGHTBOX_FILMSTRIP_CONTROLS_LEFT { border: 0px; outline: none 0px; width: 20px; height: 20px; position: absolute; top: 20px; cursor: pointer; }

.CSS_LIGHTBOX_FILMSTRIP_CONTROLS_RIGHT { border: 0px; outline: none 0px; width: 20px; height: 20px; position: absolute; left: 104px; top: 20px; cursor: pointer; }

.CSS_LIGHTBOX_FILMSTRIP_THUMBNAILS_CONTAINER { position: absolute; padding-top: 5px; overflow: hidden; float: none; height: 54px; top: 0px; }

.CSS_LIGHTBOX_FILMSTRIP_THUMBNAIL { background-color: rgb(51, 51, 51); overflow: hidden; width: 50px; height: 50px; }

.CSS_LIGHTBOX_FILMSTRIP_THUMBNAIL_MARGIN { margin-right: 3px; }

