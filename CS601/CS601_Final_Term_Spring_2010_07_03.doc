\par 
\par }{\cf0\ulc0\insrsid10816525 What methods of line discipline are used for peer to peer and  primary secondary communication?
\par }{\b\f0\cf0\ulc0\insrsid5654169 Answer:}{\b\f0\cf0\ulc0\insrsid10816525 
\par }{\f0\cf0\ulc0\insrsid5654169\charrsid15801301 Line discipline is done in two ways:
\par {\listtext\pard\plain\insrsid15801301\charrsid15801301 \hich\af0\dbch\af0\loch\f0 1.\tab}}\pard \ql \fi-360\li720\ri0\nowidctlpar\faauto\ls38\rin0\lin720\itap0\pararsid5654169 {\f0\cf0\ulc0\insrsid15801301\charrsid15801301 
ENQ/ACK      (Enquiry Acknowledgement)}{\f0\cf0\ulc0\insrsid5654169\charrsid15801301 
\par }\pard \ql \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0\pararsid15801301 {\f0\cf0\ulc0\insrsid15801301\charrsid15801301 
\par }\pard \ql \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0\pararsid10816525 {\f0\cf0\ulc0\insrsid15801301\charrsid15801301          This is used for peer to peer communication.}{\f0\cf0\ulc0\insrsid5654169\charrsid15801301 
\par {\listtext\pard\plain\insrsid15801301\charrsid15801301 \hich\af0\dbch\af0\loch\f0 2.\tab}}\pard \ql \fi-360\li720\ri0\nowidctlpar\faauto\ls38\rin0\lin720\itap0\pararsid15801301 {\f0\cf0\ulc0\insrsid15801301\charrsid15801301 Poll/ Select
\par }\pard \ql \li720\ri0\nowidctlpar\faauto\rin0\lin720\itap0\pararsid15801301 {\f0\cf0\ulc0\insrsid15801301\charrsid15801301 This method is used for primary secondary communication.
\par }\pard \ql \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0\pararsid10816525 {\f0\cf0\ulc0\insrsid5654169\charrsid15801301 
