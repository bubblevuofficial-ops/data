<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="3.1-701">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:ModifyDate>2009-06-01T13:13:40+08:00</xap:ModifyDate>
         <xap:CreateDate>2009-06-01T13:12:56Z</xap:CreateDate>
         <xap:MetadataDate>2009-06-01T13:13:40+08:00</xap:MetadataDate>
         <xap:CreatorTool>Advanced PDF Repair: http://www.pdf-repair.com</xap:CreatorTool>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tensors &amp; their Applications </rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Nazrul Islam</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mathematics, Physics</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>The book is written is in easy-to-read style with corresponding examples. The main aim of this book is to precisely explain the fundamentals of Tensors and their applications to Mechanics</rdf:li>
               <rdf:li>Elasticity</rdf:li>
               <rdf:li>Theory of Relativity</rdf:li>
               <rdf:li>Electromagnetic</rdf:li>
               <rdf:li>Riemannian Geometry and many other disciplines of science and engineering</rdf:li>
               <rdf:li>in a lucid manner. The text has been explained section wise</rdf:li>
               <rdf:li>every concept has been narrated in the form of definition</rdf:li>
               <rdf:li>examples and questions related to the concept taught. The overall package of the book is highly useful and interesting for the people associated with the field.</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Copyright (c) 2006, New Age International Pvt. Ltd., Publishers</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>uuid:0dd8b111-bfa6-40a9-b4c3-ee5e613656af</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:1ef37ab7-af87-4b02-bfb5-e262624f7d6f</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Advanced PDF Repair: http://www.pdf-repair.com</pdf:Producer>
         <pdf:Keywords>The book is written is in easy-to-read style with corresponding examples. The main aim of this book is to precisely explain the fundamentals of Tensors and their applications to Mechanics; Elasticity; Theory of Relativity; Electromagnetic; Riemannian Geometry and many other disciplines of science and engineering; in a lucid manner. The text has been explained section wise; every concept has been narrated in the form of definition; examples and questions related to the concept taught. The overall package of the book is highly useful and interesting for the people associated with the field.</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/">
         <photoshop:AuthorsPosition>Islam</photoshop:AuthorsPosition>
         <photoshop:CaptionWriter>Nazrul Islam is currently working as an Assistant Professor, Department of Applied Sciences at AIET, Lucknow. He has been teaching the students of B.Tech. and M.C.A. courses. Before joining AIET, Lucknow, he was teaching in Lucknow University as the Visiting Lecturer. He also worked at AIDC, Lucknow. He obtained his Ph.D. degree from Lucknow University under the supervision of Prof. Ram Nivas. He has published his several research papers in various journals of national and international repute.</photoshop:CaptionWriter>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapRights="http://ns.adobe.com/xap/1.0/rights/">
         <xapRights:Marked>True</xapRights:Marked>
      </rdf:Description>
   </rdf:RDF>
