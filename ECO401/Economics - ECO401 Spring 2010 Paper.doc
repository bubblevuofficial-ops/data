000000009001000000000440001254696d6573204e657720526f6d616e0000000000000000000000000000000000040000002d01000004000000020101000500
00000902000000020d000000320a5a00ffff01000400ffff0000670e0d0020f32d00030000001e0008000000fa0200000600000000000000040000002d010100
07000000fc020100000000000000040000002d0102000800000025030200040003005f0e030008000000fa0200000000000000000000040000002d0103000700
0000fc020000ffffff000000040000002d01040004000000f0010100040000002701ffff1c000000fb021000070000000000bc02000000000102022253797374656d000000000000fd99807c58bd1e0010f9230070bb1e005ae78339040000002d010100030000000000}}{\rtlch\fcs1 \ab\af1 \ltrch\fcs0 
\b\f1\insrsid8014045  Differentiate between international trade and international finance.
\par ANSWER:}{\rtlch\fcs1 \af1 \ltrch\fcs0 \f1\insrsid8014045 
\par }{\rtlch\fcs1 \af39\afs22 \ltrch\fcs0 \f39\fs22\insrsid8014045 By }{\rtlch\fcs1 \ab\af39\afs22 \ltrch\fcs0 \b\f39\fs22\ul\insrsid8014045 international trade}{\rtlch\fcs1 \af39\afs22 \ltrch\fcs0 \f39\fs22\insrsid8014045 
, we mean the exchange of goods and services between different countries.
\par International trade is the trade between two or more different countries. It is just the opposite of the trade that takes place within a country i.e. national trade.
\par Whereas}{\rtlch\fcs1 \ab\af39\afs22 \ltrch\fcs0 \b\f39\fs22\ul\insrsid8014045  International finance}{\rtlch\fcs1 \af39\afs22 \ltrch\fcs0 \f39\fs22\insrsid8014045  is concerned with, among other thing, the mobility of financial capital across
\par countries, and the problems and opportunities this mobility presents individual countries with. It would
\par not be too inaccurate (in present day context) to say that while international trade deals with the current
\par account, international finance deals with the capital account of the BOPs. That said, issues like the
\par choice of exchange rate regime and of modern-day balance of payments crises also fall firmly within the
\par purview of international finance.
\par }\pard \ltrpar\qc \fi360\li-360\ri0\nowidctlpar\tx1170\wrapdefault{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\aspalpha\aspnum\faauto\adjustright\rin0\lin-360\itap0\pararsid7559332 {\field\fldedit{\*\fldinst {\rtlch\fcs1 \af0\afs40 \ltrch\fcs0 
\b\fs40\kerning2\insrsid7559332  HYPERLINK "http://www.vutube.edu.pk/" }}{\fldrslt {\rtlch\fcs1 \af0\afs40 \ltrch\fcs0 \cs15\b\fs40\ul\cf2\kerning2\insrsid7559332 WWW.VUTUBE.EDU.PK}}}\sectd \ltrsect\linex0\sectdefaultcl\sftnbj {\rtlch\fcs1 \af0\afs40 
\ltrch\fcs0 \b\fs40\kerning2\insrsid7559332 
\par }\pard \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\faauto\rin0\lin0\itap0 {\rtlch\fcs1 \ab\af1 \ltrch\fcs0 \b\f1\insrsid8014045 
