00d0c9ea79f9bace118c8200aa004ba90b0200000003000000e0c9ea79f9bace118c8200aa004ba90ba600000068007400740070003a002f002f00650063006f006e006f006d006900630073002e00610062006f00750074002e0063006f006d002f006c006900620072006100720079002f0067006c006f00730073006100
720079002f0062006c006400650066002d006100670067007200650067006100740065002d00640065006d0061006e0064002e00680074006d000000795881f43b1d7f48af2c825dc485276300000000a5ab000000}}}{\fldrslt {\rtlch\fcs1 \af0 \ltrch\fcs0 \cf1\insrsid8014045 aggregate demand}}}
\sectd \ltrsect\linex0\sectdefaultcl\sftnbj {\rtlch\fcs1 \af0 \ltrch\fcs0 \cf1\insrsid8014045  is called }{\rtlch\fcs1 \ab\af0 \ltrch\fcs0 \b\cf1\insrsid8014045 demand-pull inflation}{\rtlch\fcs1 \af0 \ltrch\fcs0 \cf1\insrsid8014045 
. Such an inflation may arise from any individual factor that increases aggregate demand, but the main ones that generate }{\rtlch\fcs1 \ai\af0 \ltrch\fcs0 \i\cf1\insrsid8014045 ongoing}{\rtlch\fcs1 \af0 \ltrch\fcs0 \cf1\insrsid8014045 
 increases in aggregate demand are :
