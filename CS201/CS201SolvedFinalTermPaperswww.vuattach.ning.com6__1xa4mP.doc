\brdrs\brdrw10\brdrcf1 \cltxlrtb\clftsWidth3\clwWidth8856\clshdrawnil \cellx8748\pard\plain \ql \li0\ri0\widctlpar\intbl\faauto\rin0\lin0\pararsid2387776\yts34 \f10\fs22\cf1\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\ulc1 {
\f1\fs20\cf0\ulc0\insrsid2387776\charrsid2387776 #include <stdio.h>
\par #include <iostream>
\par #include <cstring>
\par using namespace std;
\par 
\par class Date
\par \{
\par public:
\par \tab int day;
\par \tab int month;
\par \tab int year;
\par 
\par public:
\par \tab Date()
\par \tab \tab \{
\par \tab \tab \tab day=0;
\par \tab \tab \tab month=0;
\par \tab \tab \tab year=0;
\par 
\par \tab \tab \}
\par 
\par \tab void setDay(int);
\par \tab void setMonth (int);
\par \tab void setYear(int);
\par 
\par \tab int getDay();
\par \tab int getMonth();
\par \tab int getYear();
\par 
\par \tab void showDate();
\par \};
\par void Date: :setDay(int d)
\par \{
\par \tab if\{d<1 | | d>31)
\par \tab cout<<"Invalid month Renter it";
\par \tab cin>>d;
\par \}
\par \tab day=d;
\par \}
\par 
\par void Date: :setMonth (int m)
\par \{
\par \tab if(m<1 | | m>12)
\par \{
\par \tab cout<<"Invalid month Renter it";
\par \tab cin>>m;
\par \}
\par \tab month=m;
\par \}
\par \tab void Date: :setYear (int y)
\par \{
\par \tab year=y;
\par 
\par \tab int Date: :getDay()
\par \{
\par \tab return day;
\par \}
\par \tab int Date: :getMonth()
\par \{
\par \tab return month:
\par \}
\par \tab int Date: :getYear()
\par \{
\par \tab return year;
\par \}
\par \tab void Date: :showDate()
\par \{
\par \tab cout<<day<<"-"<<month<<"-"<<year<<end1;
\par \}
\par Class Person
\par \{
\par public:
\par 
\par \tab char *Name;
\par    char *Address
\par \tab Date Bday;
\par 
\par public:
\par \tab Student()
\par \tab \{
\par \tab Name=new char[20];
\par \tab Address=new char[10];
\par \tab cin.getline(Name,20);
\par \tab cout<<"Enter Address:";
\par \tab cin.getline(Address,10);
\par \tab \}
\par 
\par void setDate()
\par \{
\par \tab cout<<"Enter Day:";
\par \tab cin>>Ad_date.day;
\par \tab cout<<"Enter month:";
\par \tab cin>>Ad_date.month;
\par \tab cout<<"Enter Year:";
\par \tab cin>>Ad_date.year;
\par \tab \}
\par void Display()
\par \tab \{
\par \tab cout<<"Name: "<<end1;
\par \tab cout<<"Address: "<<Address<<end1;
\par \tab cout<<"Date of Birth: ";
\par \tab Ad-date.showDate();
\par \tab \}
\par \};
\par void main()
\par \{
\par \tab Person object;
\par \tab object.setDate();
\par 
\par \tab object.Display();
\par 
\par \tab system("pause");
\par \}
