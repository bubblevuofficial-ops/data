\par }{\f39\cf0\ulc0\insrsid10773752 Find solution in following box:
\par 
\par }\pard\plain \ql \li0\ri0\widctlpar\intbl\faauto\rin0\lin0\pararsid10773752\yts34 \f10\fs22\cf1\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\ulc1 {\f1\fs20\cf0\ulc0\insrsid10773752\charrsid10773752 #include <stdio.h>
\par #include <iostream>
\par #include <cstring>
\par using namespace std;
\par 
\par class myclass
\par 
\par \{
\par 
\par public:
\par int a;
\par int b;
\par int *iptr, *sptr;
\par 
\par construct\{int,int.int\}
\par 
\par \tab void seta(int);
\par \tab void setb(int);
\par \tab void setc(int);
\par 
\par \tab int geta();
\par \tab int getb();
\par \tab int getc();
\par 
\par 
\par 
\par \};
\par 
\par void Person: :seta(int aa)
\par \{
\par 
\par \tab a=aa;
\par \}
\par 
\par void Person: :setb (int bb)
\par \{
\par 
\par \tab b=bb;
\par \}
\par \tab void Person: :setc (int cc)
\par \{
\par \tab c=cc;
\par \}
\par 
\par main()
\par 
\par \{
\par 
\par int num;
\par 
\par cout<<"Enter the number of objects to be created";
\par 
\par cin>>num;
\par 
\par for (int i =1;i==num;i++)
\par \{
\par 
\par Person i_
\par 
\par \}
\par 
\par 
\par 
\par \}
\par }\pard \ql \li0\ri0\widctlpar\intbl\faauto\rin0\lin0\yts34 {\f39\cf0\ulc0\insrsid10773752 \cell }\pard\plain \ql \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0 \f10\fs24\cf1\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\ulc1 {
