\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af0 \ltrch\fcs0 \f1\cf2\insrsid5719658\charrsid16654566 \hich\af1\dbch\af0\loch\f1 4)\tab}}\pard \ltrpar\qj \fi-360\li720\ri0\nowidctlpar\wrapdefault\faauto\ls5\rin0\lin720\itap0\pararsid3935476 {\rtlch\fcs1 \af0 
