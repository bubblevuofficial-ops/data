\par }\pard \ltrpar\ql \li0\ri0\nowidctlpar\wrapdefault\faauto\rin0\lin0\itap0 {\rtlch\fcs1 \af0 \ltrch\fcs0 \cf0\ulc0\insrsid3895221 Ans:}{\rtlch\fcs1 \af0 \ltrch\fcs0 \cf0\ulc0\insrsid1319977 
