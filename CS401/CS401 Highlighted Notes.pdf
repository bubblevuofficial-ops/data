/RC (<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:11.0.0" xfa:spec="2.0.2"><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">MUL performs unsigned&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">&#x20;multiplication of source operand w</span><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">ith accumulator.&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">if source operand is byte, it is m</span><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">ultiplied by register AL</span><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">, result&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">returned in AH and AL.&#x20;</span><span style="text-align:left;font-size:13pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">1&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">If source operand is word,&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">&#x20;it is multiplied by register AX.&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">, result returned in DX and AX.</span></p></body>)
