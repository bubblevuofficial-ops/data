/RC (<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:11.0.0" xfa:spec="2.0.2"><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">mappimg from two dimensional&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">screen to one dimensional &#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">memory</span><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">:&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">&#x20;multiply row number by 80&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">and add column number to it.&#x0A;</span></p><p dir="ltr"><span style="text-align:left;font-size:9pt;font-style:normal;font-weight:normal;color:#0000FF;font-family:Helvetica">and again multiply by 2.</span></p></body>)
