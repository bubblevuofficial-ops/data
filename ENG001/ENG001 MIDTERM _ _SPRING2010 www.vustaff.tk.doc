}\b\fs24  \b0 Turn each sentence into passive voice.\par
\par
1) The mechanic has not repaired the DVD recorder.\par
2) They play handball.\par
3) Sue puts the rucksack on the floor.\par
4) The girls had lost the match.\par
5) The teacher is not going to open the window.\par
\par
\par
\par
\par
\pard{\pntext\f0 1)\tab}{\*\pn\pnlvlbody\pnf0\pnindent360\pnstart1\pndec{\pntxta)}}
\fi-360\li720 The DVD recorder had not been repaired by the mechanic.\par
\pard{\pntext\f0 2)\tab}{\*\pn\pnlvlbody\pnf0\pnindent360\pnstart2\pndec{\pntxta)}}
\fi-360\li720 Handball played by them.\par
\pard{\pntext\f0 3)\tab}{\*\pn\pnlvlbody\pnf0\pnindent360\pnstart3\pndec{\pntxta)}}
\fi-360\li720 The rucksack put on the floor by Sue.\par
\pard{\pntext\f0 4)\tab}{\*\pn\pnlvlbody\pnf0\pnindent360\pnstart4\pndec{\pntxta)}}
\fi-360\li720 The match had been lost by girls.\par
\pard{\pntext\f0 5)\tab}{\*\pn\pnlvlbody\pnf0\pnindent360\pnstart5\pndec{\pntxta)}}
\fi-360\li720 The  window is not being opened by the teacher.\par
\pard\li360\par
